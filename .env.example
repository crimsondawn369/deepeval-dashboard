# Lilly Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Azure AD (used by tests/evals/metrics.py to get a token for the judge model)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

AZURE_MODEL_NAME=
AZURE_DEPLOYMENT_NAME=

OPENAI_API_VERSION=2024-02-15-preview

# Magnolai chat connector
# MAGNOLAI_ENV: which Magnolai environment to hit. Verified via DNS (dig) that
# only aichat-api.test.magnolai.lilly.com and aichat-api.prod.magnolai.lilly.com
# actually have a backend record — aichat-api.dev/.qa/.stage/.staging do NOT
# exist in DNS at all (NXDOMAIN), even though the corresponding www.<env> web
# UI does exist and lets SSO login succeed. Using one of those as MAGNOLAI_ENV
# will let "Connect" succeed but every query() call will fail on DNS
# resolution ("nodename nor servname provided, or not known") before it even
# sends a request — which looks like an auth problem but isn't one.
# MAGNOLAI_MODEL: model name the stream should request, if supported
MAGNOLAI_ENV=test
MAGNOLAI_MODEL=gpt-5.4
